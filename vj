gen_bash_completion() {
  cat <<'EOF'
_vj_completions() {
    local cur prev words cword
    _init_completion || return

    local commands="record play preview list random encrypt decrypt stats config completions help"
    local profiles="terry balanced hq"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${commands}" -- "${cur}") )
        return 0
    fi

    case "${words[1]}" in
        record)
            if [[ "${prev}" == "-p" || "${prev}" == "--profile" ]]; then
                COMPREPLY=( $(compgen -W "${profiles}" -- "${cur}") )
            else
                COMPREPLY=( $(compgen -W "-p --profile -e --encrypt --no-encrypt -t --title --tags -n --note -i --interactive -v --verbose terry balanced hq" -- "${cur}") )
            fi
            ;;
        play|preview)
            local entries
            entries=$(vj list -q 2>/dev/null)
            COMPREPLY=( $(compgen -W "${entries}" -- "${cur}") )
            ;;
        encrypt|decrypt)
            local entries
            entries="all $(vj list -q 2>/dev/null)"
            COMPREPLY=( $(compgen -W "${entries}" -- "${cur}") )
            ;;
        completions)
            COMPREPLY=( $(compgen -W "bash zsh fish install" -- "${cur}") )
            ;;
        list|ls)
            COMPREPLY=( $(compgen -W "-q --quiet" -- "${cur}") )
            ;;
    esac
}
complete -F _vj_completions vj
EOF
}

gen_zsh_completion() {
  cat <<'EOF'
#compdef vj

_vj_entries() {
    local -a entries
    entries=(${(f)"$(vj list -q 2>/dev/null)"})
    _describe -t entries 'vj entries' entries
}

_vj() {
    local -a commands
    commands=(
        'record:Record a new video entry'
        'play:Play entry in mpv'
        'preview:Display metadata and note for an entry'
        'list:List all journal entries'
        'random:Play a random past entry'
        'encrypt:Encrypt entries with GPG AES-256'
        'decrypt:Decrypt entries to plaintext'
        'stats:Display storage and recording summary'
        'config:Open configuration file in editor'
        'completions:Generate or install shell completion scripts'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args' && return 0

    case $state in
        command)
            _describe -t commands 'vj command' commands
            ;;
        args)
            case $words[1] in
                record)
                    _arguments \
                        '(-p --profile)'{-p,--profile}'[Compression profile]:profile:(terry balanced hq)' \
                        '(-e --encrypt)'{-e,--encrypt}'[Encrypt with GPG AES-256]' \
                        '--no-encrypt[Save unencrypted]' \
                        '(-t --title)'{-t,--title}'[Title of entry]:title:' \
                        '--tags[Comma-separated tags]:tags:' \
                        '(-n --note)'{-n,--note}'[Open editor for note]' \
                        '(-i --interactive)'{-i,--interactive}'[Prompt for title and note]' \
                        '(-v --verbose)'{-v,--verbose}'[Verbose output]'
                    ;;
                play|preview)
                    _arguments \
                        '1:entry:_vj_entries' \
                        '(-v --verbose)'{-v,--verbose}'[Verbose output]'
                    ;;
                encrypt|decrypt)
                    _arguments \
                        '1:entry:("all" $(vj list -q 2>/dev/null))'
                    ;;
                completions)
                    _arguments \
                        '1:shell:(bash zsh fish install)'
                    ;;
            esac
            ;;
    esac
}

_vj "$@"
EOF
}

# --- Command: Completions ---
cmd_completions() {
  local target="${1:-install}"
  case "${target}" in
    fish)
      gen_fish_completion
      ;;
    bash)
      gen_bash_completion
      ;;
    zsh)
      gen_zsh_completion
      ;;
    install)
      echo "Installing shell completions..."
      # Fish
      mkdir -p "$HOME/.config/fish/completions"
      gen_fish_completion > "$HOME/.config/fish/completions/vj.fish"
      echo "[✓] Installed Fish completion to ~/.config/fish/completions/vj.fish"
      
      # Bash
      mkdir -p "$HOME/.local/share/bash-completion/completions"
      gen_bash_completion > "$HOME/.local/share/bash-completion/completions/vj"
      echo "[✓] Installed Bash completion to ~/.local/share/bash-completion/completions/vj"
      
      # Zsh
      mkdir -p "$HOME/.zfunc"
      gen_zsh_completion > "$HOME/.zfunc/_vj"
      echo "[✓] Installed Zsh completion to ~/.zfunc/_vj (ensure ~/.zfunc is in fpath in ~/.zshrc)"
      ;;
    *)
      echo "Usage: vj completions [fish|bash|zsh|install]"
      ;;
  esac
}

# --- Command: Help ---
cmd_help() {
  cat <<EOF
Usage: vj [command] [options]

Commands:
  record [profile] [-e|--encrypt] [-t|--title "Title"] [--tags "a,b"] [-n|--note] [-i|--interactive] [-v]
      Record a new entry (defaults to terry profile, default title, zero prompts)
  
  play [entry_id] [-v]
      Play entry in mpv with zero-leak RAM streaming
      (Opens fzf with rich metadata/notes preview if no ID given)
  
  preview <entry_id>
      Display metadata, size, status, and note for an entry
  
  list / ls [-q]
      List all journal entries in chronological table format (-q for IDs only)
  
  random [-v]
      Play a random past entry
  
  encrypt <entry_id|all>
      Encrypt specified entry or all entries with GPG AES-256
  
  decrypt <entry_id|all>
      Decrypt specified entry or all entries to plaintext
  
  stats
      Display storage and recording summary
  
  config
      Open configuration file in \$EDITOR (${EDITOR})

  completions [fish|bash|zsh|install]
      Output or install shell completions (embedded, zero-dependency)

Options:
  -v, --verbose    Show verbose ffmpeg / mpv logs
  -h, --help       Show this help message

Configuration:
  Edit ${CONFIG_FILE} to customize storage directory, Jalali calendar, key file, camera, etc.
EOF
}

# --- Main Entrypoint ---
case "${1:-}" in
  record|rec|r)
    shift
    cmd_record "$@"
    ;;
  play|watch|p|w)
    shift
    cmd_play "$@"
    ;;
  preview)
    shift
    cmd_preview "$@"
    ;;
  list|ls|l)
    shift
    cmd_list "$@"
    ;;
  random|rand)
    shift
    cmd_random "$@"
    ;;
  encrypt|enc)
    shift
    cmd_encrypt "$@"
    ;;
  decrypt|dec)
    shift
    cmd_decrypt "$@"
    ;;
  stats|stat|s)
    cmd_stats
    ;;
  completions|completion)
    shift
    cmd_completions "$@"
    ;;
  config|cfg)
    "${EDITOR}" "${CONFIG_FILE}"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  "")
    cmd_help
    ;;
  *)
    # If given a date/timestamp or option directly
    if [ -d "${ENTRIES_DIR}/$1" ]; then
      cmd_play "$1"
    else
      echo "Unknown command: $1"
      cmd_help
      exit 1
    fi
    ;;
esac
