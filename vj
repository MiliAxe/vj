#!/usr/bin/env bash

# ==============================================================================
#  vj - Fast, Minimal CLI Video Journal
# ==============================================================================

set -eo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
BASE_DIR="${SCRIPT_DIR}"

# XDG Base Directory specification compliance
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="${XDG_CONFIG_HOME}/vj"
CONFIG_FILE="${CONFIG_DIR}/config.env"

# Resolution order:
# 1. ~/.config/vj/config.env
# 2. ~/.config/vj/config
# 3. Fallback to legacy ~/.config/diary/config.env or ./config.env
if [ -f "${CONFIG_DIR}/config.env" ]; then
  CONFIG_FILE="${CONFIG_DIR}/config.env"
elif [ -f "${CONFIG_DIR}/config" ]; then
  CONFIG_FILE="${CONFIG_DIR}/config"
elif [ -f "${XDG_CONFIG_HOME}/diary/config.env" ]; then
  CONFIG_FILE="${XDG_CONFIG_HOME}/diary/config.env"
elif [ -f "${BASE_DIR}/config.env" ]; then
  CONFIG_FILE="${BASE_DIR}/config.env"
fi

mkdir -p "${CONFIG_DIR}"

# Load config if present
if [ -f "${CONFIG_FILE}" ]; then
  # shellcheck source=/dev/null
  source "${CONFIG_FILE}"
fi

# Expand paths (Default to $HOME/Videos/Journal/entries and inbox)
eval "ENTRIES_DIR=\"${JOURNAL_DIR:-${ENTRIES_DIR:-${HOME}/Videos/Journal/entries}}\""
eval "INBOX_DIR=\"${INBOX_DIR:-$(dirname "${ENTRIES_DIR}")/inbox}\""
eval "KEY_FILE=\"${KEY_FILE:-}\""
TEMP_DIR="${TEMP_DIR:-/tmp/vj_temp}"
INBOX_PORT="${INBOX_PORT:-8080}"

# Configuration Defaults
CAMERA_DEV="${CAMERA_DEV:-/dev/video0}"
AUDIO_SRC="${AUDIO_SRC:-default}"
DEFAULT_PROFILE="${DEFAULT_PROFILE:-terry}"
AUTO_ENCRYPT="${AUTO_ENCRYPT:-false}"
DATE_CALENDAR="${DATE_CALENDAR:-jalali}" # 'jalali' or 'gregorian'
EDITOR="${EDITOR:-nvim}"
if ! command -v "${EDITOR}" &>/dev/null; then
  EDITOR="vim"
fi

mkdir -p "${ENTRIES_DIR}" "${INBOX_DIR}" "${TEMP_DIR}"

# Helper: Timestamp generator using native jdate or standard date
get_timestamp() {
  if [ "${DATE_CALENDAR}" = "jalali" ] || [ "${USE_JALALI:-false}" = "true" ]; then
    if command -v jdate &>/dev/null; then
      jdate +"%Y-%m-%d_%H-%M-%S"
    else
      python3 -c "
import datetime
def g2j(gy, gm, gd):
    g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    gy2 = gy if gm > 2 else gy - 1
    days = 355666 + (365 * gy) + ((gy2 + 3) // 4) - ((gy2 + 99) // 100) + ((gy2 + 399) // 400) + gd + g_d_m[gm - 1]
    jy = -1595 + (33 * (days // 12053))
    days %= 12053
    jy += 4 * (days // 1461)
    days %= 1461
    if days > 365:
        jy += (days - 1) // 365
        days = (days - 1) % 365
    if days < 186:
        jm = 1 + (days // 31)
        jd = 1 + (days % 31)
    else:
        jm = 7 + ((days - 186) // 30)
        jd = 1 + ((days - 186) % 30)
    return jy, jm, jd

now = datetime.datetime.now()
jy, jm, jd = g2j(now.year, now.month, now.day)
print(f'{jy:04d}-{jm:02d}-{jd:02d}_{now.strftime(\"%H-%M-%S\")}')
"
    fi
  else
    date +"%Y-%m-%d_%H-%M-%S"
  fi
}

# Helper: Extract creation timestamp from a video file (EXIF/QuickTime or mtime)
get_video_creation_timestamp() {
  local vfile="$1"
  local iso_date=""
  if command -v ffprobe &>/dev/null; then
    iso_date=$(ffprobe -v error -show_entries format_tags=creation_time:stream_tags=creation_time -of default=noprint_wrappers=1:nokey=1 "$vfile" 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -n 1 || true)
  fi

  if [ -n "${iso_date}" ]; then
    local epoch
    epoch=$(date -d "${iso_date}" +%s 2>/dev/null || stat -c %Y "$vfile" 2>/dev/null || date +%s)
    if [ "${DATE_CALENDAR}" = "jalali" ] || [ "${USE_JALALI:-false}" = "true" ]; then
      python3 -c "
import datetime
epoch = int('${epoch}')
dt = datetime.datetime.fromtimestamp(epoch)
def g2j(gy, gm, gd):
    g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    gy2 = gy if gm > 2 else gy - 1
    days = 355666 + (365 * gy) + ((gy2 + 3) // 4) - ((gy2 + 99) // 100) + ((gy2 + 399) // 400) + gd + g_d_m[gm - 1]
    jy = -1595 + (33 * (days // 12053))
    days %= 12053
    jy += 4 * (days // 1461)
    days %= 1461
    if days > 365:
        jy += (days - 1) // 365
        days = (days - 1) % 365
    if days < 186:
        jm = 1 + (days // 31)
        jd = 1 + (days % 31)
    else:
        jm = 7 + ((days - 186) // 30)
        jd = 1 + ((days - 186) % 30)
    return jy, jm, jd
jy, jm, jd = g2j(dt.year, dt.month, dt.day)
print(f'{jy:04d}-{jm:02d}-{jd:02d}_{dt.strftime(\"%H-%M-%S\")}')
" 2>/dev/null || date -d "@${epoch}" +"%Y-%m-%d_%H-%M-%S"
    else
      date -d "@${epoch}" +"%Y-%m-%d_%H-%M-%S"
    fi
  else
    # Fallback to file modification time
    if [ "${DATE_CALENDAR}" = "jalali" ] || [ "${USE_JALALI:-false}" = "true" ]; then
      if command -v jdate &>/dev/null; then
        jdate -r "$vfile" +"%Y-%m-%d_%H-%M-%S" 2>/dev/null || date -r "$vfile" +"%Y-%m-%d_%H-%M-%S"
      else
        date -r "$vfile" +"%Y-%m-%d_%H-%M-%S" 2>/dev/null || get_timestamp
      fi
    else
      date -r "$vfile" +"%Y-%m-%d_%H-%M-%S" 2>/dev/null || get_timestamp
    fi
  fi
}

# Helper: GPG Arguments for Passphrase/Keyfile handling
get_gpg_auth_flags() {
  if [ -n "${KEY_FILE}" ] && [ -f "${KEY_FILE}" ]; then
    echo "--pinentry-mode loopback --passphrase-file ${KEY_FILE}"
  elif [ -n "${VJ_PASSPHRASE:-${DIARY_PASSPHRASE:-}}" ]; then
    echo "--pinentry-mode loopback --passphrase ${VJ_PASSPHRASE:-${DIARY_PASSPHRASE}}"
  else
    echo ""
  fi
}

# Profile specifications
get_profile_params() {
  local profile="$1"
  local upper_name
  upper_name=$(echo "${profile}" | tr '[:lower:]-' '[:upper:]_')
  local var_name="PROFILE_${upper_name}"

  # 1. Custom user profile from config.env (e.g. PROFILE_MYPROFILE="...")
  if [ -n "${!var_name:-}" ]; then
    echo "${!var_name}"
    return 0
  fi

  # 2. Built-in profiles
  case "${profile}" in
    potato|micro|ultra)
      # Extreme low-bandwidth: ~2 MB / 10 min (~12 MB / hour)
      echo "320x240 10 libsvtav1 4 48 libopus 1 10k scale=320:240,fps=10,hqdn3d=5:4:7:5,unsharp=3:3:0.5 highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
    compact)
      # Compact & clear: ~4.5 MB / 10 min (~27 MB / hour)
      echo "480x360 12 libsvtav1 4 44 libopus 1 12k scale=480:360,fps=12,hqdn3d=4:3:6:4.5,unsharp=3:3:0.5 highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
    terry|default)
      # Retro talking-head sweet spot: ~8 MB / 10 min (~48 MB / hour)
      echo "640x480 15 libsvtav1 4 38 libopus 1 14k scale=640:480,fps=15,hqdn3d=3:2.5:5:4,unsharp=3:3:0.4 highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
    balanced)
      # Crisp 720p speech & cam: ~22 MB / 10 min (~130 MB / hour)
      echo "1280x720 24 libsvtav1 5 30 libopus 2 32k scale=1280:720,fps=24,hqdn3d=1.5:1.5:3:3 highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
    hq)
      # High-def archival: ~60 MB / 10 min (~360 MB / hour)
      echo "1920x1080 30 libsvtav1 6 24 libopus 2 64k scale=1920:1080,fps=30 loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
    *)
      # Fallback to terry
      echo "640x480 15 libsvtav1 4 38 libopus 1 14k scale=640:480,fps=15,hqdn3d=3:2.5:5:4,unsharp=3:3:0.4 highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11 -svtav1-params tune=0:film-grain=0"
      ;;
  esac
}

# Auto migrate legacy files if any
migrate_legacy_files() {
  local loose_files
  shopt -s nullglob
  loose_files=("${BASE_DIR}"/entry_*.mkv "${BASE_DIR}"/entry_*.mkv.gpg)
  shopt -u nullglob

  if [ ${#loose_files[@]} -gt 0 ]; then
    for f in "${loose_files[@]}"; do
      local bname
      bname=$(basename "$f")
      local stamp
      stamp=$(echo "$bname" | sed -E 's/^entry_([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}).*/\1/')
      if [ -n "$stamp" ]; then
        local entry_folder="${ENTRIES_DIR}/${stamp}"
        mkdir -p "${entry_folder}"
        if [[ "$bname" == *.gpg ]]; then
          mv "$f" "${entry_folder}/video.mkv.gpg"
        else
          mv "$f" "${entry_folder}/video.mkv"
        fi
        
        if [ ! -f "${entry_folder}/meta.json" ] && [ ! -f "${entry_folder}/meta.json.gpg" ]; then
          cat <<EOF > "${entry_folder}/meta.json"
{
  "timestamp": "${stamp}",
  "profile": "legacy",
  "tags": ["migrated"],
  "title": "Migrated Entry ${stamp}"
}
EOF
        fi
      fi
    done
  fi
}

# --- Command: Record ---
cmd_record() {
  local profile="${DEFAULT_PROFILE}"
  local do_encrypt="${AUTO_ENCRYPT}"
  local custom_title=""
  local custom_tags=""
  local verbose=false
  local open_note=false
  local interactive=false

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--profile)
        profile="$2"
        shift 2
        ;;
      -e|--encrypt)
        do_encrypt="true"
        shift
        ;;
      --no-encrypt)
        do_encrypt="false"
        shift
        ;;
      -t|--title)
        custom_title="$2"
        shift 2
        ;;
      --tags)
        custom_tags="$2"
        shift 2
        ;;
      -n|--note)
        open_note=true
        shift
        ;;
      -i|--interactive)
        interactive=true
        shift
        ;;
      -v|--verbose)
        verbose=true
        shift
        ;;
      -*)
        shift
        ;;
      *)
        profile="$1"
        shift
        ;;
    esac
  done

  local params
  params=$(get_profile_params "${profile}")
  local res fps vcodec vpreset vcrf acodec achannels abitrate vfilter afilter extra_flags
  read -r res fps vcodec vpreset vcrf acodec achannels abitrate vfilter afilter extra_flags <<< "${params}"

  local timestamp
  timestamp=$(get_timestamp)
  local entry_folder="${ENTRIES_DIR}/${timestamp}"
  local temp_raw="${TEMP_DIR}/raw_${timestamp}.mkv"
  local final_out="${entry_folder}/video.mkv"
  local meta_file="${entry_folder}/meta.json"
  local note_file="${entry_folder}/note.md"

  mkdir -p "${entry_folder}"

  local log_opt="-loglevel error"
  local play_log="-loglevel quiet -nostats"
  if [ "${verbose}" = "true" ]; then
    log_opt="-loglevel info"
    play_log="-loglevel info"
  fi

  echo "Recording [${profile}: ${res}@${fps}fps] -> ${timestamp} (Close preview or press 'q' to stop)"

  # Step 1: Capture with live preview
  if [ "${verbose}" = "true" ]; then
    ffmpeg -hide_banner ${log_opt} \
      -f v4l2 -framerate "${fps}" -video_size "${res}" -i "${CAMERA_DEV}" \
      -f pulse -i "${AUDIO_SRC}" \
      -filter_complex "[0:v]split=2[rec_v][preview_v]" \
      -map "[rec_v]" -map 1:a \
      -c:v libx264 -preset ultrafast -crf 17 \
      -c:a pcm_s16le \
      "${temp_raw}" \
      -map "[preview_v]" -c:v rawvideo -pix_fmt yuv420p -f nut - |
      ffplay -hide_banner ${play_log} -window_title "vj recording (${timestamp})" -f nut - || true
  else
    ffmpeg -hide_banner -loglevel quiet \
      -f v4l2 -framerate "${fps}" -video_size "${res}" -i "${CAMERA_DEV}" \
      -f pulse -i "${AUDIO_SRC}" \
      -filter_complex "[0:v]split=2[rec_v][preview_v]" \
      -map "[rec_v]" -map 1:a \
      -c:v libx264 -preset ultrafast -crf 17 \
      -c:a pcm_s16le \
      "${temp_raw}" \
      -map "[preview_v]" -c:v rawvideo -pix_fmt yuv420p -f nut - 2>/dev/null |
      ffplay -hide_banner -loglevel quiet -nostats -window_title "vj recording (${timestamp})" -f nut - 2>/dev/null || true
  fi

  if [ ! -f "${temp_raw}" ] || [ ! -s "${temp_raw}" ]; then
    echo "Recording cancelled or no data captured."
    rm -rf "${entry_folder}"
    return 1
  fi

  echo "Capture finished."

  # Step 2: Metadata & Notes Handling
  if [ "${interactive}" = "true" ] && [ -t 0 ]; then
    read -r -p "Title [press enter for default]: " custom_title
    read -r -p "Tags (comma-separated, optional): " custom_tags
    read -r -p "Write note in ${EDITOR}? [y/N]: " note_resp
    if [[ "${note_resp}" =~ ^[Yy]$ ]]; then
      open_note=true
    fi
  fi

  if [ -z "${custom_title}" ]; then
    custom_title="Entry ${timestamp}"
  fi

  local tags_json="[]"
  if [ -n "${custom_tags}" ]; then
    IFS=',' read -ra ADDR <<< "${custom_tags}"
    local formatted_tags=()
    for t in "${ADDR[@]}"; do
      trimmed=$(echo "$t" | xargs)
      formatted_tags+=("\"${trimmed}\"")
    done
    tags_json="[$(IFS=,; echo "${formatted_tags[*]}")]"
  fi

  # Open note editor if requested via flag or interactive
  if [ "${open_note}" = "true" ]; then
    cat <<EOF > "${note_file}"
# ${custom_title}
*Date: ${timestamp}*
*Tags: ${custom_tags}*

EOF
    "${EDITOR}" "${note_file}"
  fi

  # Metadata
  cat <<EOF > "${meta_file}"
{
  "timestamp": "${timestamp}",
  "calendar": "${DATE_CALENDAR}",
  "title": "${custom_title}",
  "profile": "${profile}",
  "resolution": "${res}",
  "fps": ${fps},
  "tags": ${tags_json},
  "encrypted": false
}
EOF

  # Step 3: Background Compression + Encryption
  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  (
    local vf_arg=""
    if [ -n "${vfilter:-}" ] && [ "${vfilter}" != "null" ]; then
      vf_arg="-vf ${vfilter}"
    fi

    local af_arg=""
    if [ -n "${afilter:-}" ] && [ "${afilter}" != "null" ]; then
      af_arg="-af ${afilter}"
    fi

    local extra_opts=()
    if [ -n "${extra_flags:-}" ] && [ "${extra_flags}" != "null" ]; then
      read -ra extra_opts <<< "${extra_flags}"
    fi
    if [ -n "${EXTRA_FFMPEG_FLAGS:-}" ]; then
      local global_extra=()
      read -ra global_extra <<< "${EXTRA_FFMPEG_FLAGS}"
      extra_opts+=("${global_extra[@]}")
    fi

    # Suppress all SVT-AV1 / ffmpeg stdout & stderr in subshell or write to encode.log on error
    local encode_log="${entry_folder}/encode.log"
    if nice -n 19 ionice -c 3 ffmpeg -hide_banner -loglevel error \
      -i "${temp_raw}" \
      ${vf_arg} \
      -c:v "${vcodec}" -preset "${vpreset}" -crf "${vcrf}" -g 240 -pix_fmt yuv420p \
      ${extra_opts[@]+"${extra_opts[@]}"} \
      ${af_arg} \
      -c:a "${acodec}" -ac "${achannels}" -b:a "${abitrate}" -application voip \
      "${final_out}" > "${encode_log}" 2>&1; then
      rm -f "${temp_raw}" "${encode_log}"
    else
      notify-send "vj error" "Encoding failed for ${timestamp}. Check ${encode_log}" 2>/dev/null || true
      return 1
    fi

    if [ "${do_encrypt}" = "true" ]; then
      # Encrypt video
      # shellcheck disable=SC2086
      gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${final_out}" >/dev/null 2>&1 && rm -f "${final_out}"
      
      # Encrypt note if present
      if [ -f "${note_file}" ]; then
        # shellcheck disable=SC2086
        gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${note_file}" >/dev/null 2>&1 && rm -f "${note_file}"
      fi

      # Update metadata
      sed -i 's/"encrypted": false/"encrypted": true/' "${meta_file}"
      # shellcheck disable=SC2086
      gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${meta_file}" >/dev/null 2>&1 && rm -f "${meta_file}"
    fi

    notify-send "vj" "Finished encoding entry: ${timestamp}" 2>/dev/null || true
  ) >/dev/null 2>&1 &

  disown
  echo "Encoding in background (PID: $!). Entry saved to ${entry_folder}"
}

# --- Command: Preview Inbox Item (used by fzf) ---
cmd_preview_inbox() {
  local f="$1"
  if [ ! -f "$f" ]; then
    echo "File not found: $f"
    return 1
  fi

  echo "================ INBOX VIDEO PREVIEW ================"
  echo "File:         $(basename "$f")"
  echo "Size:         $(du -h "$f" | cut -f1)"
  echo "Path:         $f"
  echo ""

  if command -v ffprobe &>/dev/null; then
    local info
    info=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height,r_frame_rate,codec_name:format=duration -of default=noprint_wrappers=1 "$f" 2>/dev/null || true)
    local width height fps codec duration
    width=$(echo "$info" | grep '^width=' | cut -d= -f2)
    height=$(echo "$info" | grep '^height=' | cut -d= -f2)
    codec=$(echo "$info" | grep '^codec_name=' | cut -d= -f2)
    fps=$(echo "$info" | grep '^r_frame_rate=' | cut -d= -f2 | awk -F/ '{if($2>0) printf "%.0f", $1/$2; else print $1}')
    duration=$(echo "$info" | grep '^duration=' | cut -d= -f2 | awk '{printf "%02d:%02d:%02d", $1/3600, ($1%3600)/60, $1%60}')
    
    if [ -n "${width}" ] && [ -n "${height}" ]; then
      echo "Resolution:   ${width}x${height} @ ${fps}fps"
      echo "Codec:        ${codec}"
      echo "Duration:     ${duration}"
    fi
  fi

  local detected_stamp
  detected_stamp=$(get_video_creation_timestamp "$f")
  echo "Detected Date: ${detected_stamp}"
  echo "Target Folder: ${ENTRIES_DIR}/${detected_stamp}"
}

# --- Command: Import from Inbox or Specified Files ---
cmd_import() {
  local profile="${DEFAULT_PROFILE}"
  local do_encrypt="${AUTO_ENCRYPT}"
  local custom_title=""
  local custom_tags=""
  local open_note=false
  local interactive=false
  local keep_raw=false
  local verbose=false
  local specified_files=()

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--profile)
        profile="$2"
        shift 2
        ;;
      -e|--encrypt)
        do_encrypt="true"
        shift
        ;;
      --no-encrypt)
        do_encrypt="false"
        shift
        ;;
      -t|--title)
        custom_title="$2"
        shift 2
        ;;
      --tags)
        custom_tags="$2"
        shift 2
        ;;
      -n|--note)
        open_note=true
        shift
        ;;
      -i|--interactive)
        interactive=true
        shift
        ;;
      --keep)
        keep_raw=true
        shift
        ;;
      -v|--verbose)
        verbose=true
        shift
        ;;
      -*)
        echo "Unknown option: $1"
        return 1
        ;;
      *)
        if [ -f "$1" ]; then
          specified_files+=("$1")
        else
          profile="$1"
        fi
        shift
        ;;
    esac
  done

  local files_to_import=()

  if [ ${#specified_files[@]} -gt 0 ]; then
    files_to_import=("${specified_files[@]}")
  else
    # Scan inbox directory for videos
    shopt -s nullglob nocaseglob
    local inbox_candidates=("${INBOX_DIR}"/*.mp4 "${INBOX_DIR}"/*.mkv "${INBOX_DIR}"/*.mov "${INBOX_DIR}"/*.webm "${INBOX_DIR}"/*.3gp "${INBOX_DIR}"/*.avi "${INBOX_DIR}"/*.m4v "${INBOX_DIR}"/*.ts)
    shopt -u nullglob nocaseglob

    if [ ${#inbox_candidates[@]} -eq 0 ]; then
      echo "No video files found in inbox: ${INBOX_DIR}"
      echo "You can drop video files into ${INBOX_DIR} or run 'vj inbox-server' to upload from your phone."
      return 0
    fi

    if [ -t 0 ] && command -v fzf &>/dev/null; then
      local preview_cmd
      if command -v vj &>/dev/null; then
        preview_cmd="vj preview-inbox {}"
      else
        preview_cmd="\"${SCRIPT_PATH}\" preview-inbox {}"
      fi

      local selected_raw
      selected_raw=$(printf "%s\n" "${inbox_candidates[@]}" | fzf -m \
        --prompt="Select Videos to Import (Tab to multi-select) > " \
        --header="[Tab: Multi-select | Ctrl-A: Select All | Enter: Import | Esc: Cancel]" \
        --preview="${preview_cmd}" \
        --preview-window="right:55%:wrap" \
        --bind="ctrl-a:select-all,ctrl-j:down,ctrl-k:up,ctrl-d:page-down,ctrl-u:page-up" || true)

      if [ -z "${selected_raw}" ]; then
        echo "Import cancelled."
        return 0
      fi

      IFS=$'\n' read -r -d '' -a files_to_import <<< "${selected_raw}" || true
    else
      files_to_import=("${inbox_candidates[@]}")
    fi
  fi

  if [ ${#files_to_import[@]} -eq 0 ]; then
    echo "No files selected for import."
    return 0
  fi

  local params
  params=$(get_profile_params "${profile}")
  local res fps vcodec vpreset vcrf acodec achannels abitrate vfilter afilter extra_flags
  read -r res fps vcodec vpreset vcrf acodec achannels abitrate vfilter afilter extra_flags <<< "${params}"

  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  echo "Importing ${#files_to_import[@]} video file(s) [Profile: ${profile}]..."

  for raw_file in "${files_to_import[@]}"; do
    if [ ! -f "${raw_file}" ]; then
      echo "Skipping missing file: ${raw_file}"
      continue
    fi

    local bname
    bname=$(basename "${raw_file}")
    local timestamp
    timestamp=$(get_video_creation_timestamp "${raw_file}")
    
    local entry_folder="${ENTRIES_DIR}/${timestamp}"
    local count=1
    while [ -d "${entry_folder}" ]; do
      timestamp="${timestamp}_${count}"
      entry_folder="${ENTRIES_DIR}/${timestamp}"
      ((count++)) || true
    done

    mkdir -p "${entry_folder}"
    local final_out="${entry_folder}/video.mkv"
    local meta_file="${entry_folder}/meta.json"
    local note_file="${entry_folder}/note.md"

    local this_title="${custom_title}"
    local this_tags="${custom_tags}"
    local this_open_note="${open_note}"

    if [ "${interactive}" = "true" ] && [ -t 0 ]; then
      echo ""
      echo "--- Configuring: ${bname} (Date: ${timestamp}) ---"
      read -r -p "Title [press enter for 'Imported: ${bname}']: " input_title
      if [ -n "${input_title}" ]; then this_title="${input_title}"; fi
      read -r -p "Tags (comma-separated, optional): " input_tags
      if [ -n "${input_tags}" ]; then this_tags="${input_tags}"; fi
      read -r -p "Write note in ${EDITOR}? [y/N]: " note_resp
      if [[ "${note_resp}" =~ ^[Yy]$ ]]; then
        this_open_note=true
      fi
    fi

    if [ -z "${this_title}" ]; then
      this_title="Imported: ${bname}"
    fi

    local tags_json="[]"
    if [ -n "${this_tags}" ]; then
      IFS=',' read -ra ADDR <<< "${this_tags}"
      local formatted_tags=()
      for t in "${ADDR[@]}"; do
        trimmed=$(echo "$t" | xargs)
        formatted_tags+=("\"${trimmed}\"")
      done
      tags_json="[$(IFS=,; echo "${formatted_tags[*]}")]"
    fi

    if [ "${this_open_note}" = "true" ]; then
      cat <<EOF > "${note_file}"
# ${this_title}
*Imported: ${bname}*
*Date: ${timestamp}*
*Tags: ${this_tags}*

EOF
      "${EDITOR}" "${note_file}"
    fi

    cat <<EOF > "${meta_file}"
{
  "timestamp": "${timestamp}",
  "calendar": "${DATE_CALENDAR}",
  "title": "${this_title}",
  "original_filename": "${bname}",
  "imported": true,
  "profile": "${profile}",
  "tags": ${tags_json},
  "encrypted": false
}
EOF

    echo "Compressing [${profile}] ${bname} -> ${timestamp}..."

    local vf_arg=""
    if [ -n "${vfilter:-}" ] && [ "${vfilter}" != "null" ]; then
      vf_arg="-vf ${vfilter}"
    fi

    local af_arg=""
    if [ -n "${afilter:-}" ] && [ "${afilter}" != "null" ]; then
      af_arg="-af ${afilter}"
    fi

    local extra_opts=()
    if [ -n "${extra_flags:-}" ] && [ "${extra_flags}" != "null" ]; then
      read -ra extra_opts <<< "${extra_flags}"
    fi
    if [ -n "${EXTRA_FFMPEG_FLAGS:-}" ]; then
      local global_extra=()
      read -ra global_extra <<< "${EXTRA_FFMPEG_FLAGS}"
      extra_opts+=("${global_extra[@]}")
    fi

    local log_arg="-loglevel quiet"
    if [ "${verbose}" = "true" ]; then
      log_arg="-loglevel info"
    fi

    nice -n 19 ionice -c 3 ffmpeg -hide_banner ${log_arg} \
      -i "${raw_file}" \
      ${vf_arg} \
      -c:v "${vcodec}" -preset "${vpreset}" -crf "${vcrf}" -g 240 -pix_fmt yuv420p \
      ${extra_opts[@]+"${extra_opts[@]}"} \
      ${af_arg} \
      -c:a "${acodec}" -ac "${achannels}" -b:a "${abitrate}" -application voip \
      "${final_out}" >/dev/null 2>&1

    if [ "${do_encrypt}" = "true" ]; then
      # shellcheck disable=SC2086
      gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${final_out}" >/dev/null 2>&1 && rm -f "${final_out}"
      if [ -f "${note_file}" ]; then
        # shellcheck disable=SC2086
        gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${note_file}" >/dev/null 2>&1 && rm -f "${note_file}"
      fi
      sed -i 's/"encrypted": false/"encrypted": true/' "${meta_file}"
      # shellcheck disable=SC2086
      gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${meta_file}" >/dev/null 2>&1 && rm -f "${meta_file}"
    fi

    if [ "${keep_raw}" = "false" ]; then
      rm -f "${raw_file}"
    fi

    echo "[✓] Imported ${bname} -> ${entry_folder}"
  done

  notify-send "vj" "Finished importing ${#files_to_import[@]} video(s)" 2>/dev/null || true
  echo "All imports completed."
}

