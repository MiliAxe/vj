class InboxHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def do_GET(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(HTML_PAGE.encode('utf-8'))

    def do_POST(self):
        if self.path == '/upload':
            ctype = self.headers.get('Content-Type', '')
            clength = int(self.headers.get('Content-Length', 0))
            if 'multipart/form-data' in ctype and clength > 0:
                raw_body = self.rfile.read(clength)
                msg_feed = f'Content-Type: {ctype}\n\n'.encode('utf-8') + raw_body
                msg = email.parser.BytesFeedParser(policy=email.policy.default)
                msg.feed(msg_feed)
                parsed = msg.close()

                saved_files = []
                for part in parsed.iter_parts():
                    filename = part.get_filename()
                    if filename:
                        clean_fn = os.path.basename(filename)
                        out_path = os.path.join(INBOX, clean_fn)
                        payload = part.get_payload(decode=True)
                        if payload:
                            with open(out_path, 'wb') as f:
                                f.write(payload)
                            size_mb = len(payload) / (1024 * 1024)
                            print(f'  [✓ UPLOADED] {clean_fn} ({size_mb:.1f} MB) -> inbox/')
                            saved_files.append(clean_fn)

                self.send_response(200)
                self.send_header('Content-Type', 'text/plain')
                self.end_headers()
                self.wfile.write(b'OK')
                return

        self.send_response(400)
        self.end_headers()

with socketserver.TCPServer(('0.0.0.0', PORT), InboxHandler) as httpd:
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print('\nStopping inbox server.')
PYEOF
}

# --- Command: List entries ---
cmd_list() {
  migrate_legacy_files
  local quiet=false
  if [ "${1:-}" = "-q" ] || [ "${1:-}" = "--quiet" ]; then
    quiet=true
  fi

  shopt -s nullglob
  local dirs=("${ENTRIES_DIR}"/*)
  shopt -u nullglob

  if [ ${#dirs[@]} -eq 0 ]; then
    if [ "${quiet}" = "false" ]; then
      echo "No entries found in ${ENTRIES_DIR}"
    fi
    return 0
  fi

  IFS=$'\n' sorted_dirs=($(sort -r <<<"${dirs[*]}"))
  unset IFS

  if [ "${quiet}" = "false" ]; then
    printf "%-22s %-10s %-8s %-32s %s\n" "ID / TIMESTAMP" "STATUS" "SIZE" "TITLE" "TAGS"
    printf "%-22s %-10s %-8s %-32s %s\n" "----------------------" "----------" "--------" "--------------------------------" "----------------"
  fi

  for d in "${sorted_dirs[@]}"; do
    if [ -d "$d" ]; then
      local stamp
      stamp=$(basename "$d")
      if [ "${quiet}" = "true" ]; then
        echo "${stamp}"
        continue
      fi

      local status="[RAW]"
      local vfile="${d}/video.mkv"
      if [ -f "${d}/video.mkv.gpg" ]; then
        status="[GPG]"
        vfile="${d}/video.mkv.gpg"
      fi

      local title="Entry ${stamp}"
      local tags=""
      if [ -f "${d}/meta.json" ]; then
        local t_val
        t_val=$(grep -o '"title": *"[^"]*"' "${d}/meta.json" | cut -d'"' -f4 || true)
        if [ -n "$t_val" ]; then title="$t_val"; fi
        tags=$(grep -o '"tags": *\[[^]]*\]' "${d}/meta.json" | sed 's/"tags": *//' || true)
      fi

      local size_hr="0B"
      if [ -f "$vfile" ]; then
        size_hr=$(du -h "$vfile" | cut -f1)
      elif [ -f "${TEMP_DIR}/raw_${stamp}.mkv" ]; then
        size_hr="(enc...)"
      fi

      printf "%-22s %-10s %-8s %-32s %s\n" "${stamp}" "${status}" "${size_hr}" "${title}" "${tags}"
    fi
  done
}

# --- Helper: Preview single entry (used by fzf) ---
cmd_preview() {
  local stamp="$1"
  local d="${ENTRIES_DIR}/${stamp}"

  if [ ! -d "$d" ]; then
    echo "Entry directory not found: $stamp"
    return 1
  fi

  echo "=================== ENTRY DETAILS ==================="
  echo "Timestamp:    ${stamp}"
  echo "Location:     ${d}"

  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  if [ -f "${d}/video.mkv.gpg" ]; then
    echo "Status:       🔒 AES-256 GPG Encrypted"
    echo "Size:         $(du -h "${d}/video.mkv.gpg" | cut -f1)"
    
    if [ -f "${d}/meta.json.gpg" ]; then
      echo ""
      echo "--- Metadata ---"
      if [ -n "${gpg_auth}" ]; then
        # shellcheck disable=SC2086
        gpg --batch --decrypt ${gpg_auth} "${d}/meta.json.gpg" 2>/dev/null || echo "(Encrypted metadata)"
      else
        echo "(Metadata is GPG encrypted)"
      fi
    fi

    if [ -f "${d}/note.md.gpg" ]; then
      echo ""
      echo "--- Note Preview ---"
      if [ -n "${gpg_auth}" ]; then
        # shellcheck disable=SC2086
        gpg --batch --decrypt ${gpg_auth} "${d}/note.md.gpg" 2>/dev/null | head -n 25 || echo "(Encrypted note)"
      else
        echo "(Note is GPG encrypted)"
      fi
    fi
  elif [ -f "${d}/video.mkv" ]; then
    echo "Status:       Plaintext"
    echo "Size:         $(du -h "${d}/video.mkv" | cut -f1)"
    if [ -f "${d}/meta.json" ]; then
      echo ""
      echo "--- Metadata ---"
      cat "${d}/meta.json"
    fi
    if [ -f "${d}/note.md" ]; then
      echo ""
      echo "--- Note Preview ---"
      head -n 25 "${d}/note.md"
    fi
  elif [ -f "${TEMP_DIR}/raw_${stamp}.mkv" ]; then
    echo "Status:       Compressing in background..."
  fi
}

# --- Command: Play Entry ---
cmd_play() {
  migrate_legacy_files
  local target="${1:-}"
  local verbose=false
  if [ "${2:-}" = "-v" ] || [ "${2:-}" = "--verbose" ]; then
    verbose=true
  fi

  # If no target, open interactive fzf with metadata preview
  if [ -z "${target}" ]; then
    if [ -t 0 ] && command -v fzf &>/dev/null; then
      local preview_cmd
      if command -v vj &>/dev/null; then
        preview_cmd="vj preview {1}"
      else
        preview_cmd="\"${SCRIPT_PATH}\" preview {1}"
      fi

      local raw_line
      raw_line=$(cmd_list | sed '1,2d' | fzf \
        --prompt="vj play > " \
        --header="[j/k: Navigate | C-u/C-d: Scroll Preview | Enter: Play | Esc: Quit]" \
        --preview="${preview_cmd}" \
        --preview-window="right:55%:wrap" \
        --bind="ctrl-j:down,ctrl-k:up,ctrl-d:page-down,ctrl-u:page-up,ctrl-y:preview-up,ctrl-e:preview-down" || true)
      target=$(echo "${raw_line}" | awk '{print $1}')
    else
      target=$(cmd_list -q | head -n 1)
    fi
  fi

  if [ -z "${target}" ]; then
    return 0
  fi

  local entry_dir="${ENTRIES_DIR}/${target}"
  if [ ! -d "${entry_dir}" ]; then
    # Try finding by partial match
    local found
    found=$(find "${ENTRIES_DIR}" -maxdepth 1 -type d -name "*${target}*" | head -n 1)
    if [ -n "${found}" ]; then
      entry_dir="${found}"
      target=$(basename "${found}")
    else
      echo "Entry not found: ${target}"
      return 1
    fi
  fi

  local mpv_opts=("--title=vj - ${target}")
  if [ "${verbose}" = "false" ]; then
    mpv_opts+=("--msg-level=all=no" "--really-quiet")
  fi

  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  if [ -f "${entry_dir}/video.mkv.gpg" ]; then
    # shellcheck disable=SC2086
    gpg --batch --decrypt ${gpg_auth} "${entry_dir}/video.mkv.gpg" 2>/dev/null | mpv "${mpv_opts[@]}" - || {
      # Fallback to interactive pinentry if batch fails
      gpg --decrypt "${entry_dir}/video.mkv.gpg" 2>/dev/null | mpv "${mpv_opts[@]}" - || {
        echo "Failed to decrypt or play entry ${target}."
        return 1
      }
    }
  elif [ -f "${entry_dir}/video.mkv" ]; then
    mpv "${mpv_opts[@]}" "${entry_dir}/video.mkv"
  else
    echo "Video file missing or still compressing."
    return 1
  fi
}

# --- Command: Random Play ---
cmd_random() {
  migrate_legacy_files
  local verbose=false
  if [ "${1:-}" = "-v" ] || [ "${1:-}" = "--verbose" ]; then
    verbose=true
  fi

  shopt -s nullglob
  local dirs=("${ENTRIES_DIR}"/*)
  shopt -u nullglob

  if [ ${#dirs[@]} -eq 0 ]; then
    echo "No entries found."
    return 1
  fi

  local random_dir="${dirs[RANDOM % ${#dirs[@]}]}"
  local stamp
  stamp=$(basename "${random_dir}")
  echo "Playing random entry: ${stamp}"
  cmd_play "${stamp}" "$@"
}

# --- Command: Encrypt / Decrypt ---
cmd_encrypt() {
  local target="${1:-}"
  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  if [ -z "${target}" ]; then
    echo "Usage: vj encrypt <entry_id|all>"
    return 1
  fi

  local targets=()
  if [ "${target}" = "all" ]; then
    shopt -s nullglob
    targets=("${ENTRIES_DIR}"/*)
    shopt -u nullglob
  else
    targets=("${ENTRIES_DIR}/${target}")
  fi

  for d in "${targets[@]}"; do
    if [ -d "$d" ]; then
      local stamp
      stamp=$(basename "$d")
      if [ -f "${d}/video.mkv" ]; then
        echo "Encrypting ${stamp}..."
        # shellcheck disable=SC2086
        gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${d}/video.mkv" >/dev/null 2>&1 && rm -f "${d}/video.mkv"
        if [ -f "${d}/note.md" ]; then
          # shellcheck disable=SC2086
          gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${d}/note.md" >/dev/null 2>&1 && rm -f "${d}/note.md"
        fi
        if [ -f "${d}/meta.json" ]; then
          sed -i 's/"encrypted": false/"encrypted": true/' "${d}/meta.json"
          # shellcheck disable=SC2086
          gpg --batch --yes ${gpg_auth} --symmetric --cipher-algo AES256 "${d}/meta.json" >/dev/null 2>&1 && rm -f "${d}/meta.json"
        fi
      fi
    fi
  done
  echo "Encryption complete."
}

cmd_decrypt() {
  local target="${1:-}"
  local gpg_auth
  gpg_auth=$(get_gpg_auth_flags)

  if [ -z "${target}" ]; then
    echo "Usage: vj decrypt <entry_id|all>"
    return 1
  fi

  local targets=()
  if [ "${target}" = "all" ]; then
    shopt -s nullglob
    targets=("${ENTRIES_DIR}"/*)
    shopt -u nullglob
  else
    targets=("${ENTRIES_DIR}/${target}")
  fi

  for d in "${targets[@]}"; do
    if [ -d "$d" ]; then
      local stamp
      stamp=$(basename "$d")
      if [ -f "${d}/video.mkv.gpg" ]; then
        echo "Decrypting ${stamp}..."
        # shellcheck disable=SC2086
        gpg --batch --yes ${gpg_auth} --decrypt "${d}/video.mkv.gpg" > "${d}/video.mkv" 2>/dev/null && rm -f "${d}/video.mkv.gpg"
        if [ -f "${d}/note.md.gpg" ]; then
          # shellcheck disable=SC2086
          gpg --batch --yes ${gpg_auth} --decrypt "${d}/note.md.gpg" > "${d}/note.md" 2>/dev/null && rm -f "${d}/note.md.gpg"
        fi
        if [ -f "${d}/meta.json.gpg" ]; then
          # shellcheck disable=SC2086
          gpg --batch --yes ${gpg_auth} --decrypt "${d}/meta.json.gpg" > "${d}/meta.json" 2>/dev/null && rm -f "${d}/meta.json.gpg"
          sed -i 's/"encrypted": true/"encrypted": false/' "${d}/meta.json"
        fi
      fi
    fi
  done
  echo "Decryption complete."
}

# --- Command: Stats ---
cmd_stats() {
  migrate_legacy_files
  shopt -s nullglob
  local dirs=("${ENTRIES_DIR}"/*)
  shopt -u nullglob

  local total_entries=${#dirs[@]}
  local encrypted_count=0
  local raw_count=0

  for d in "${dirs[@]}"; do
    if [ -f "${d}/video.mkv.gpg" ]; then
      ((encrypted_count++)) || true
    elif [ -f "${d}/video.mkv" ]; then
      ((raw_count++)) || true
    fi
  done

  local disk_usage
  disk_usage=$(du -sh "${ENTRIES_DIR}" 2>/dev/null | cut -f1 || echo "0B")

  local days_recorded=()
  for d in "${dirs[@]}"; do
    local day
    day=$(basename "$d" | cut -d'_' -f1)
    days_recorded+=("${day}")
  done

  local unique_days=0
  if [ ${#days_recorded[@]} -gt 0 ]; then
    unique_days=$(printf "%s\n" "${days_recorded[@]}" | sort -u | wc -l)
  fi

  echo "Location:       ${ENTRIES_DIR}"
  echo "Inbox:          ${INBOX_DIR}"
  echo "Calendar:       ${DATE_CALENDAR}"
  echo "Total Entries:  ${total_entries}"
  echo "Plaintext:      ${raw_count}"
  echo "Encrypted:      ${encrypted_count}"
  echo "Storage:        ${disk_usage}"
  echo "Recorded Days:  ${unique_days}"
}

# --- Command: Profiles ---
cmd_profiles() {
  echo "vj Compression Profiles:"
  echo ""
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "PROFILE" "RESOLUTION & FPS" "VIDEO (AV1)" "AUDIO (OPUS)" "EST. (10 MIN)" "EST. (1 HOUR)"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "------------" "------------------" "------------------" "------------------" "----------------" "----------------"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "potato" "320x240 @ 10fps" "SVT-AV1 CRF 48" "10 kbps (Mono)" "~2.0 MB" "~12 MB"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "compact" "480x360 @ 12fps" "SVT-AV1 CRF 44" "12 kbps (Mono)" "~4.5 MB" "~27 MB"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "terry (*)" "640x480 @ 15fps" "SVT-AV1 CRF 38" "14 kbps (Mono)" "~8.0 MB" "~48 MB"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "balanced" "1280x720 @ 24fps" "SVT-AV1 CRF 30" "32 kbps (Stereo)" "~22 MB" "~130 MB"
  printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "hq" "1920x1080 @ 30fps" "SVT-AV1 CRF 24" "64 kbps (Stereo)" "~60 MB" "~360 MB"

  # Detect user-defined profiles in environment / config.env
  local custom_found=false
  local env_vars
  env_vars=$(compgen -v PROFILE_ 2>/dev/null || true)
  if [ -n "${env_vars}" ]; then
    while IFS= read -r var_name; do
      local pname
      pname=$(echo "${var_name#PROFILE_}" | tr '[:upper:]' '[:lower:]')
      if [[ "$pname" != "potato" && "$pname" != "compact" && "$pname" != "terry" && "$pname" != "balanced" && "$pname" != "hq" && "$pname" != "default" && "$pname" != "micro" && "$pname" != "ultra" ]]; then
        if [ "${custom_found}" = "false" ]; then
          echo ""
          echo "User-Defined Profiles (from ${CONFIG_FILE}):"
          printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "PROFILE" "RESOLUTION & FPS" "VIDEO (AV1)" "AUDIO (OPUS)" "EST. (10 MIN)" "EST. (1 HOUR)"
          printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "------------" "------------------" "------------------" "------------------" "----------------" "----------------"
          custom_found=true
        fi
        local val="${!var_name}"
        local cres cfps cvcodec cvpreset cvcrf cacodec cachannels cabitrate _
        read -r cres cfps cvcodec cvpreset cvcrf cacodec cachannels cabitrate _ <<< "$val"
        printf "%-12s %-18s %-18s %-18s %-16s %-16s\n" "${pname}" "${cres} @ ${cfps}fps" "${cvcodec} CRF ${cvcrf}" "${cabitrate} (${cacodec})" "Custom" "Custom"
      fi
    done <<< "${env_vars}"
  fi

  echo ""
  echo "(*) Default profile. Change with DEFAULT_PROFILE=\"...\" in ${CONFIG_FILE}"
  echo "Define custom profiles in ${CONFIG_FILE} via PROFILE_<NAME>=\"...\""
}

