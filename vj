        'config:Open configuration file in editor'
        'completions:Generate or install shell completion scripts'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args' && return 0

    case $state in
        command)
            _describe -t commands 'vj command' commands
            ;;
        args)
            case $words[1] in
                record)
                    _arguments \
                        '(-p --profile)'{-p,--profile}'[Compression profile]:profile:(potato compact terry balanced hq)' \
                        '(-e --encrypt)'{-e,--encrypt}'[Encrypt with GPG AES-256]' \
                        '--no-encrypt[Save unencrypted]' \
                        '(-t --title)'{-t,--title}'[Title of entry]:title:' \
                        '--tags[Comma-separated tags]:tags:' \
                        '(-n --note)'{-n,--note}'[Open editor for note]' \
                        '(-i --interactive)'{-i,--interactive}'[Prompt for title and note]' \
                        '(-v --verbose)'{-v,--verbose}'[Verbose output]'
                    ;;
                import)
                    _arguments \
                        '(-p --profile)'{-p,--profile}'[Compression profile]:profile:(potato compact terry balanced hq)' \
                        '(-e --encrypt)'{-e,--encrypt}'[Encrypt with GPG AES-256]' \
                        '--no-encrypt[Save unencrypted]' \
                        '(-t --title)'{-t,--title}'[Title of entry]:title:' \
                        '--tags[Comma-separated tags]:tags:' \
                        '(-n --note)'{-n,--note}'[Open editor for note]' \
                        '(-i --interactive)'{-i,--interactive}'[Prompt for title and note]' \
                        '--keep[Keep raw file in inbox]' \
                        '(-v --verbose)'{-v,--verbose}'[Verbose output]' \
                        '*:file:_files'
                    ;;
                play|preview)
                    _arguments \
                        '1:entry:_diary_entries' \
                        '(-v --verbose)'{-v,--verbose}'[Verbose output]'
                    ;;
                encrypt|decrypt)
                    _arguments \
                        '1:entry:("all" $(vj list -q 2>/dev/null))'
                    ;;
                completions)
                    _arguments \
                        '1:shell:(bash zsh fish install)'
                    ;;
            esac
            ;;
    esac
}

_vj "$@"
EOF
}

# --- Command: Completions ---
cmd_completions() {
  local target="${1:-install}"
  case "${target}" in
    fish)
      gen_fish_completion
      ;;
    bash)
      gen_bash_completion
      ;;
    zsh)
      gen_zsh_completion
      ;;
    install)
      echo "Installing shell completions..."
      # Fish
      mkdir -p "$HOME/.config/fish/completions"
      gen_fish_completion > "$HOME/.config/fish/completions/vj.fish"
      echo "[✓] Installed Fish completion to ~/.config/fish/completions/vj.fish"
      
      # Bash
      mkdir -p "$HOME/.local/share/bash-completion/completions"
      gen_bash_completion > "$HOME/.local/share/bash-completion/completions/vj"
      echo "[✓] Installed Bash completion to ~/.local/share/bash-completion/completions/vj"
      
      # Zsh
      mkdir -p "$HOME/.zfunc"
      gen_zsh_completion > "$HOME/.zfunc/_vj"
      echo "[✓] Installed Zsh completion to ~/.zfunc/_vj (ensure ~/.zfunc is in fpath in ~/.zshrc)"
      ;;
    *)
      echo "Usage: vj completions [fish|bash|zsh|install]"
      ;;
  esac
}

# --- Command: Help ---
cmd_help() {
  cat <<EOF
Usage: vj [command] [options]

Recording & Ingestion:
  record [profile] [-e|--encrypt] [-t|--title "Title"] [--tags "a,b"] [-n|--note] [-i|--interactive] [-v]
      Record a new entry from webcam (defaults to terry profile, instant save)
  
  import [files...] [-p profile] [-e|--encrypt] [-t "Title"] [--tags "a,b"] [-n|--note] [-i|--interactive] [--keep] [-v]
      Import video files from inbox or file paths (opens fzf multi-select with side preview pane if no files given)
  
  inbox-server [port]
      Start a local mobile upload web server with a terminal QR code for uploading phone recordings

Browsing & Playback:
  play [entry_id] [-v]
      Play entry in mpv with zero-leak RAM streaming (opens fzf with live preview if no ID given)
  
  preview <entry_id>
      Display metadata, size, status, and note for an entry
  
  preview-inbox <file_path>
      Display format, resolution, codec, duration, and detected creation date for an inbox video
  
  list / ls [-q]
      List all journal entries in chronological table format (-q for IDs only)
  
  random [-v]
      Play a random past entry

Vault Management:
  encrypt <entry_id|all>
      Encrypt specified entry or all entries with GPG AES-256
  
  decrypt <entry_id|all>
      Decrypt specified entry or all entries to plaintext
  
  stats
      Display storage and recording summary
  
  profiles
      List all available compression profiles and estimated disk footprints
  
  config
      Open configuration file in \$EDITOR (${EDITOR})

  completions [fish|bash|zsh|install]
      Output or install shell completions (embedded, zero-dependency)

Options:
  -v, --verbose    Show verbose ffmpeg / mpv logs
  -h, --help       Show this help message

Configuration:
  Edit ${CONFIG_FILE} to customize storage directory, inbox folder, Jalali calendar, key file, custom profiles, etc.
EOF
}

# --- Main Entrypoint ---
case "${1:-}" in
  record|rec|r)
    shift
    cmd_record "$@"
    ;;
  import|imp)
    shift
    cmd_import "$@"
    ;;
  inbox-server|server|srv)
    shift
    cmd_inbox_server "$@"
    ;;
  preview-inbox)
    shift
    cmd_preview_inbox "$@"
    ;;
  play|watch|p|w)
    shift
    cmd_play "$@"
    ;;
  preview)
    shift
    cmd_preview "$@"
    ;;
  list|ls|l)
    shift
    cmd_list "$@"
    ;;
  random|rand)
    shift
    cmd_random "$@"
    ;;
  encrypt|enc)
    shift
    cmd_encrypt "$@"
    ;;
  decrypt|dec)
    shift
    cmd_decrypt "$@"
    ;;
  stats|stat|s)
    cmd_stats
    ;;
  profiles|profile)
    shift
    cmd_profiles "$@"
    ;;
  completions|completion)
    shift
    cmd_completions "$@"
    ;;
  config|cfg)
    shift
    cmd_config "$@"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  "")
    cmd_help
    ;;
  *)
    # If given a date/timestamp or option directly
    if [ -d "${ENTRIES_DIR}/$1" ]; then
      cmd_play "$1"
    else
      echo "Unknown command: $1"
      cmd_help
      exit 1
    fi
    ;;
esac
